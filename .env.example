# Application
APP_NAME="My Trading Simulator"
TRADING_MODE=PAPER

# Paper trading account
STARTING_BALANCE=7000

# Risk management
MAX_POSITION_ALLOCATION=400
MAX_LOSS_PER_TRADE=150

# Trading configuration
OPTIONS_EXPIRATION=0DTE
SUPPORTED_SYMBOLS='["SPY","QQQ","IWM"]'

# Strategy
EMA_PERIOD=13
CANDLE_INTERVAL_MINUTES=2

# Profit taking
PROFIT_TAKE_FRACTION=0.75

OPTION_CONTRACT_MULTIPLIER=100
